# Track only project source, configuration, experiments, tests, and docs by default.
*

# Root project files.
!/.gitignore
!/README.md
!/Project.toml
!/Manifest.toml
!/AUTONOMOUS_NACA.md

# Tracked project directories.
!/docs/
!/docs/**
!/configs/
!/configs/**
!/src/
!/src/**
!/experiments/
!/experiments/**
!/test/
!/test/**

# Python bytecode is generated, including inside tracked experiment directories.
**/__pycache__/
*.pyc

# Generated data, runs, logs, checkpoints, caches, and most artifacts stay ignored.
# Keep optional placeholders for generated-output directories without tracking contents.
!/artifacts/
/artifacts/**
!/artifacts/.gitkeep
!/artifacts/README.md
!/runs/
/runs/**
!/runs/.gitkeep
!/runs/README.md
!/data/
/data/**
!/data/.gitkeep
!/data/README.md

# Current Dataset-2 and Dataset-2.1 reports; binary media and raw tables stay local.
!/data/dataset21_active.json
!/data/dataset2_active.json
!/data/dataset_relocations.json
!/reports/
/reports/**
!/reports/README.md
!/reports/Dataset-2/
!/reports/Dataset-2/*.md
!/reports/Dataset-2/evidence/
!/reports/Dataset-2/evidence/*.json
!/reports/Dataset-2.1/
!/reports/Dataset-2.1/*.md
!/reports/Dataset-2.1/tables/
!/reports/Dataset-2.1/tables/index.html
!/reports/Dataset-2.1/tables/summary.csv
!/reports/Dataset-2.1/evidence/
!/reports/Dataset-2.1/evidence/organization_summary.json
!/reports/Dataset-2.1/evidence/relocation.json
!/reports/Dataset-2.1/evidence/report_manifest.json
!/reports/Dataset-2.1/evidence/audit.json
!/reports/Dataset-2.1/evidence/campaign_integrity_04.json
!/reports/Dataset-2.1/evidence/campaign_completion_04.json
!/reports/Dataset-2.1/evidence/report_protocol_20261014.json

# Report-archive navigation/receipt only; formerly tracked reports retain Git history.
!/abolish/
!/abolish/reports_20261016/
!/abolish/reports_20261016/README.md
!/abolish/reports_20261016/manifest.json
