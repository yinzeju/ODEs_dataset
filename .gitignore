# Track only project source, configuration, experiments, tests, and docs by default.
*

# Root project files.
!/.gitignore
!/README.md
!/Project.toml
!/Manifest.toml
!/AUTONOMOUS_NACA.md

# Tracked project directories.
!/docs/
!/docs/**
!/configs/
!/configs/**
!/src/
!/src/**
!/experiments/
!/experiments/**
!/test/
!/test/**

# Python bytecode is generated, including inside tracked experiment directories.
**/__pycache__/
*.pyc

# Generated data, runs, logs, checkpoints, caches, and most artifacts stay ignored.
# Keep optional placeholders for generated-output directories without tracking contents.
!/artifacts/
/artifacts/**
!/artifacts/.gitkeep
!/artifacts/README.md
!/runs/
/runs/**
!/runs/.gitkeep
!/runs/README.md
!/data/
/data/**
!/data/.gitkeep
!/data/README.md

# Curated TestSub2 wrap-up documents and compact evidence only.
!/reports/
/reports/**
!/reports/TestSub_2_nonlinear_vibration/
!/reports/TestSub_2_nonlinear_vibration/TestSub_2_nonlinear_vibration.md
!/reports/TestSub_2_nonlinear_vibration/2_numerical_appendix.md
!/reports/TestSub_2_nonlinear_vibration/TestSub_2_nonlinear_vibration_evidence.json

# NLC6 report navigation and compact evidence; media, raw metrics and archives stay local.
!/reports/Dataset21_NLC6_v1_nonlinear_wing/
!/reports/Dataset21_NLC6_v1_nonlinear_wing/README.md
!/reports/Dataset21_NLC6_v1_nonlinear_wing/tables/
!/reports/Dataset21_NLC6_v1_nonlinear_wing/tables/index.html
!/reports/Dataset21_NLC6_v1_nonlinear_wing/tables/summary.csv
!/reports/Dataset21_NLC6_v1_nonlinear_wing/evidence/
!/reports/Dataset21_NLC6_v1_nonlinear_wing/evidence/organization_summary.json
!/reports/Dataset21_NLC6_v1_nonlinear_wing/evidence/relocation.json
!/reports/Dataset21_NLC6_v1_nonlinear_wing/evidence/report_manifest.json
!/reports/Dataset21_NLC6_v1_nonlinear_wing/evidence/audit.json
